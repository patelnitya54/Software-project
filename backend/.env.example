# ── JobPath Backend Configuration ──
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scraper settings
SCRAPE_COUNTRY=usa
POST_TIME=day
MAX_CONCURRENT_JOBS=10
ASHBY_TIMEOUT=20
GREENHOUSE_TIMEOUT=20
RETRY_COUNT=3
TARGET_JOBS=300

# Data paths (relative to backend/)
DATA_DIR=data/jobs
GREENHOUSE_COMPANIES_FILE=data/greenhouse_companies.txt
ASHBY_COMPANIES_FILE=data/ashby_companies.txt

